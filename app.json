{
  "expo": {
    "name": "Zera",
    "slug": "zera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zera",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F6F1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zera.app",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Zera needs calendar access to sync your events.",
        "NSRemindersUsageDescription": "Zera uses reminders to keep you on track."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#F8F6F1"
      },
      "package": "com.zera.app",
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7B8F7A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6F1",
          "image": "./assets/splash-icon.png",
          "dark": {
            "backgroundColor": "#1C1B19",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "78d03e84-2041-4d38-a340-2673c73d9463"
      }
    },
    "owner": "successfulyadav"
  }
}
